<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK плагинов Backpack: протокол обмена с хостом и базовый класс плагина. Без WPF и Win32.
    Плагин ссылается на эту сборку (Private=false): во время работы её предоставляет Backpack из своей папки.
    Версия SDK — SdkInfo.Version; совместимость — по старшему номеру.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Backpack.Sdk</RootNamespace>
    <AssemblyName>Backpack.Sdk</AssemblyName>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
  </PropertyGroup>

</Project>
