<ResourceDictionary x:Class="KeyOverlay.Visual.Settings.SettingsTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:KeyOverlay.Visual.Settings">
    <!--
      Общая система оформления окон Backpack (главное окно, справка, диагностика, диалоги, меню трея и контекстные меню,
      окна инструментов). Значения кистей Ko.*Brush, материал, свечение и шрифт подставляет UiTheme; все стили ссылаются на них
      через DynamicResource, поэтому смена темы, материала и шрифта применяется к уже открытым окнам без перезапуска.

      Геометрия (Phase 4E):
      * кнопки — прямоугольники высотой 34 DIP со скруглением 8 (≈ 0,24 высоты); малые — 28 DIP, скругление 6;
      * иконочные кнопки — квадраты 34×34 (малые 28×28) с тем же скруглением; кнопки окна — 46×32, скругление 6;
      * карточки — скругление 14, поля ввода — 8, пункты навигации — 8, сегменты — 7 внутри 9;
      * круглыми остаются только элементы, где форма задана самим инструментом или жанром элемента: радиальное меню,
        круг рисования и указателя, бегунок ползунка и дорожка переключателя.
      Состояния: наведение, нажатие, выбранное, недоступное (0,45) и видимый фокус клавиатуры (рамка Ko.FocusBrush 2 DIP).
      Свечение акцентов — отдельный слой под кнопкой (эффект не попадает на текст).
    -->
    <SolidColorBrush x:Key="Ko.WindowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ko.SidebarBrush" Color="#F7F7F8" />
    <SolidColorBrush x:Key="Ko.CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ko.CardBorderBrush" Color="#E5E5E7" />
    <SolidColorBrush x:Key="Ko.CardSheenBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Ko.FlyoutBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ko.ControlBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ko.BorderBrush" Color="#E5E5E7" />
    <SolidColorBrush x:Key="Ko.ControlBorderBrush" Color="#D4D4D8" />
    <SolidColorBrush x:Key="Ko.HoverBrush" Color="#EFEFF1" />
    <SolidColorBrush x:Key="Ko.PressedBrush" Color="#E3E3E6" />
    <SolidColorBrush x:Key="Ko.SelectedBrush" Color="#E7E7EA" />
    <SolidColorBrush x:Key="Ko.TextBrush" Color="#111113" />
    <SolidColorBrush x:Key="Ko.SecondaryTextBrush" Color="#5F5F66" />
    <SolidColorBrush x:Key="Ko.MutedTextBrush" Color="#8E8E95" />
    <SolidColorBrush x:Key="Ko.AccentBrush" Color="#111113" />
    <SolidColorBrush x:Key="Ko.AccentHoverBrush" Color="#3A3A40" />
    <SolidColorBrush x:Key="Ko.AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ko.FocusBrush" Color="#2F6FEB" />
    <SolidColorBrush x:Key="Ko.TrackBrush" Color="#E3E3E6" />
    <SolidColorBrush x:Key="Ko.ToggleOffBrush" Color="#C9C9CF" />
    <SolidColorBrush x:Key="Ko.ThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ko.ThumbBorderBrush" Color="#9A9AA1" />
    <SolidColorBrush x:Key="Ko.SegmentBackBrush" Color="#F0F0F2" />
    <SolidColorBrush x:Key="Ko.SegmentCheckedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ko.ErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="Ko.CodeBrush" Color="#F3F3F5" />
    <SolidColorBrush x:Key="Ko.LinkBrush" Color="#1F5FD1" />
    <SolidColorBrush x:Key="Ko.HighlightBrush" Color="#FFE880" />
    <SolidColorBrush x:Key="Ko.ScrollThumbBrush" Color="#C4C4CA" />
    <SolidColorBrush x:Key="Ko.AccentPressedBrush" Color="#000000" />
    <SolidColorBrush x:Key="Ko.SelectedBorderBrush" Color="#D4D4D8" />
    <SolidColorBrush x:Key="Ko.SliderFillBrush" Color="#111113" />
    <SolidColorBrush x:Key="Ko.GlowBrush" Color="#31C99A" />
    <SolidColorBrush x:Key="Ko.DisabledTextBrush" Color="#8E8E95" />
    <SolidColorBrush x:Key="Ko.DemoBrush" Color="#0B0E0D" />
    <SolidColorBrush x:Key="Ko.LogoBrush" Color="#087F5B" />
    <SolidColorBrush x:Key="Ko.StageBrush" Color="#E9EDEB" />
    <SolidColorBrush x:Key="Ko.StagePanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ko.StageLineBrush" Color="#C9D1CC" />
    <SolidColorBrush x:Key="Ko.CaptionCloseBrush" Color="#C42B1C" />
    <FontFamily x:Key="Ko.Font">pack://application:,,,/KeyOverlay.Visual;component/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Шрифт крупных заголовков (страница, справка) и названия программы: «Стандартный» (Inter) или Spectral; остальное — Ko.Font. -->
    <FontFamily x:Key="Ko.HeadingFont">pack://application:,,,/KeyOverlay.Visual;component/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <CornerRadius x:Key="Ko.CardRadius">14</CornerRadius>
    <!-- Свечение акцентных элементов (null — выключено); UiTheme заменяет значение. -->
    <x:Null x:Key="Ko.AccentGlowEffect" />

    <Style x:Key="Ko.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource Ko.FocusBrush}" BorderThickness="2" CornerRadius="10" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопки полосы заголовка окна: прямоугольники 46×32 со скруглением 6; «Закрыть» при наведении — красная. -->
    <Style x:Key="Ko.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,2,1,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="hover">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.PressedBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="pressed">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ko.CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource Ko.CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,2,4,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.CaptionCloseBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Окно Backpack: одна поверхность от верхнего края до нижнего. Полоса заголовка (44 DIP) — часть окна: тот же материал,
      логотип, заголовок и собственные кнопки окна. Перетаскивание, двойной щелчок, системное меню, изменение размера и
      Snap Layouts выполняет Windows (WindowChrome и WM_NCHITTEST, см. WindowShell). Содержимое не заходит под кнопки окна.
    -->
    <Style x:Key="Ko.Window" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Ko.WindowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Ko.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="PART_Root" Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="TitleRow" Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Phase 4H: кнопки окна — отдельный слой справа сверху. В обычном окне они стоят в полосе заголовка;
                                 во встроенном заголовке (WindowShell.IntegratedTitle, главное окно) полосы нет, и кнопки входят
                                 в верхнюю строку интерфейса (страница оставляет им место справа). -->
                            <StackPanel x:Name="PART_TitleBar" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,160,0" IsHitTestVisible="False">
                                <StackPanel x:Name="PART_Brand" Orientation="Horizontal">
                                    <Border x:Name="PART_Logo" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontFamily="{DynamicResource Ko.HeadingFont}" Foreground="{DynamicResource Ko.SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <AdornerDecorator x:Name="PART_Content" Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                            <StackPanel x:Name="PART_Captions" Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" Panel.ZIndex="10">
                                <Button x:Name="PART_Minimize" Style="{StaticResource Ko.CaptionButton}">
                                    <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" />
                                </Button>
                                <Button x:Name="PART_Maximize" Style="{StaticResource Ko.CaptionButton}">
                                    <Path x:Name="MaxGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True" />
                                </Button>
                                <Button x:Name="PART_Close" Style="{StaticResource Ko.CloseCaptionButton}">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_Minimize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="MaxGlyph" Property="Data" Value="M2.5,0.5 H9.5 V7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z" />
                        </Trigger>
                        <Trigger Property="local:WindowShell.IntegratedTitle" Value="True">
                            <Setter TargetName="TitleRow" Property="Height" Value="0" />
                            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ko.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Ko.HeadingFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
    </Style>
    <Style x:Key="Ko.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
    </Style>
    <Style x:Key="Ko.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
    </Style>
    <Style x:Key="Ko.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.SecondaryTextBrush}" />
    </Style>
    <Style x:Key="Ko.Error" TargetType="TextBlock" BasedOn="{StaticResource Ko.Hint}">
        <Setter Property="Foreground" Value="{DynamicResource Ko.ErrorBrush}" />
    </Style>

    <!-- Карточка: материал Ko.CardBrush, мягкая граница; в Liquid Glass — блик сверху (Ko.CardSheenBrush) и градиентная граница. -->
    <Style x:Key="Ko.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ko.CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ko.CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Ko.CardRadius}" />
        <Setter Property="Padding" Value="20,16,20,16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Пункт навигации: прямоугольник со скруглением 8; выбранный — подложка и акцентная полоса слева (со свечением). -->
    <Style x:Key="Ko.NavItem" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" Margin="12,7,10,7" />
                        </Border>
                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Margin="1,0,0,0" Background="{DynamicResource Ko.GlowBrush}"
                                Visibility="Collapsed" Effect="{DynamicResource Ko.AccentGlowEffect}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.SelectedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ko.SelectedBorderBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Подпункт раскрытой группы: отступ слева, меньше высота; выбранный — так же, как пункт. -->
    <Style x:Key="Ko.NavSubItem" TargetType="RadioButton" BasedOn="{StaticResource Ko.NavItem}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="30,0,0,0" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Логотип над меню — вход на «Главную» (Phase 4G): без плашки выделения, наведение — фон, текущая страница — полоса акцента. -->
    <Style x:Key="Ko.NavHome" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <Border x:Name="Bar" Width="3" Height="22" CornerRadius="1.5" HorizontalAlignment="Left" Margin="1,0,0,0" Background="{DynamicResource Ko.GlowBrush}"
                                Visibility="Collapsed" Effect="{DynamicResource Ko.AccentGlowEffect}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стрелка раскрытия группы навигации (квадратная иконочная кнопка 28×28). -->
    <Style x:Key="Ko.NavExpander" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <Path x:Name="Chevron" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Ko.SecondaryTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Прежний заголовок раскрывающейся группы (окна, где группа — отдельная кнопка). -->
    <Style x:Key="Ko.NavGroup" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,8,12,8">
                        <DockPanel>
                            <Path x:Name="Chevron" DockPanel.Dock="Right" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Ko.SecondaryTextBrush}" StrokeThickness="1.6"
                                  VerticalAlignment="Center" Margin="8,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Path.RenderTransform>
                            </Path>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Плитка каталога стилей: миниатюра и название; выбранная — с рамкой акцентного цвета. -->
    <Style x:Key="Ko.Tile" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{DynamicResource Ko.ControlBrush}" BorderBrush="{DynamicResource Ko.ControlBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="7">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ko.AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Bd" Property="Padding" Value="6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Переключатель: дорожка-«пилюля» — жанровая форма переключателя (как в концепте), не кнопка. -->
    <Style x:Key="Ko.Toggle" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid>
                            <Border x:Name="Glow" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Ko.AccentBrush}" Visibility="Hidden" Effect="{DynamicResource Ko.AccentGlowEffect}" />
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Ko.ToggleOffBrush}">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource Ko.ThumbBrush}" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Border>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Ko.AccentBrush}" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Ko.AccentTextBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ko.SegmentHost" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ko.SegmentBackBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Ko.Segment" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.SecondaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="12,4,12,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.SegmentCheckedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ko.SelectedBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Phase 4I: плитка выбора значка (каталог значков плагина): рамка, наведение, выбранное — рамка и фон выделения. -->
    <Style x:Key="Ko.IconTile" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Ko.CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ko.SelectedBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.SegmentCheckedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ko.SelectedBorderBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ko.TextBox" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Ko.FocusBrush}" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Ko.ControlBrush}" BorderBrush="{DynamicResource Ko.ControlBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ko.ThumbBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ko.FocusBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="Tag" Value="error">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ko.ErrorBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Обычная кнопка: высота 34, скругление 8, граница 1; состояния наведения, нажатия, фокуса, недоступности. -->
    <Style x:Key="Ko.Button" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Ko.ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ko.ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="14,5,14,5" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <!-- Длинная подпись переносится внутри кнопки, а не выходит за её границы (узкое окно, uk/ru). -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Основная кнопка: акцентная заливка; свечение — отдельный слой под ней (текст остаётся чётким). -->
    <Style x:Key="Ko.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Ko.Button}">
        <Setter Property="Background" Value="{DynamicResource Ko.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ko.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.AccentTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow" Background="{DynamicResource Ko.AccentBrush}" CornerRadius="8" Effect="{DynamicResource Ko.AccentGlowEffect}" />
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <!-- Длинная подпись переносится внутри кнопки, а не выходит за её границы (узкое окно, uk/ru). -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Малая кнопка: высота 28, скругление 6. -->
    <Style x:Key="Ko.SmallButton" TargetType="Button" BasedOn="{StaticResource Ko.Button}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,3,10,3" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <!-- Длинная подпись переносится внутри кнопки, а не выходит за её границы (узкое окно, uk/ru). -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Тихая кнопка (вторичные действия, ссылки-строки): без заливки и границы до наведения, та же форма. -->
    <Style x:Key="Ko.SubtleButton" TargetType="Button" BasedOn="{StaticResource Ko.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.SecondaryTextBrush}" />
    </Style>
    <Style x:Key="Ko.LinkButton" TargetType="Button" BasedOn="{StaticResource Ko.SubtleButton}">
        <Setter Property="Foreground" Value="{DynamicResource Ko.LinkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <!-- Иконочная кнопка: квадрат 34×34 со скруглением 8. -->
    <Style x:Key="Ko.IconButton" TargetType="Button" BasedOn="{StaticResource Ko.Button}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="Ko.SubtleIconButton" TargetType="Button" BasedOn="{StaticResource Ko.SubtleButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Ko.SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource Ko.ThumbBrush}" Stroke="{DynamicResource Ko.ThumbBorderBrush}" StrokeThickness="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource Ko.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="StrokeThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ko.SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ko.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Ko.SliderFillBrush}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ko.Slider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Ko.TrackBrush}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Ko.SliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Ko.SliderRepeat}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Ko.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Выпадающий список (выбор шрифта, раскладки): поле высотой 34 со скруглением 8, список во всплывающей поверхности. -->
    <Style x:Key="Ko.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource Ko.ControlBrush}" BorderBrush="{DynamicResource Ko.ControlBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Ko.SecondaryTextBrush}" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Ko.ComboBox" TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Ko.ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
                        <ContentPresenter Margin="10,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="{DynamicResource Ko.FlyoutBrush}" BorderBrush="{DynamicResource Ko.BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <VirtualizingStackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,6,10,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.SelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тонкие полосы прокрутки, читаемые в обеих темах -->
    <Style x:Key="Ko.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="4" Background="{DynamicResource Ko.ScrollThumbBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Ko.SliderRepeat}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Ko.SliderRepeat}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Ko.ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Ko.SliderRepeat}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Ko.SliderRepeat}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Ko.ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Неявные стили для обычных окон -->
    <Style TargetType="Button" BasedOn="{StaticResource Ko.Button}" />
    <Style TargetType="TextBox" BasedOn="{StaticResource Ko.TextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource Ko.ComboBox}" />

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ko.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,6,10,6" Margin="0,1,0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.SelectedBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ko.MutedTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Ko.Font}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Ko.FlyoutBrush}" BorderBrush="{DynamicResource Ko.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6,10,6" MaxWidth="420">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Меню трея и контекстные меню: всплывающая поверхность Ko.FlyoutBrush (без системного размытия), пункты со скруглением 6. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Ko.Font}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Ko.FlyoutBrush}" BorderBrush="{DynamicResource Ko.BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="240">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4,8,4" Background="{DynamicResource Ko.BorderBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Ko.TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6,10,6" MinHeight="30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Check" Data="M2,7 L6,11 L13,3" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" VerticalAlignment="Center" />
                                <!-- Phase 4H: значок пункта меню «Ещё» (то же действие, что у иконочной кнопки панели). -->
                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <Path x:Name="Arrow" Grid.Column="2" Data="M2,2 L6,6 L2,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="{DynamicResource Ko.FlyoutBrush}" BorderBrush="{DynamicResource Ko.BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="200">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ko.SelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ko.MutedTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
