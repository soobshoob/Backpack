<Window x:Class="KeyOverlay.Lab.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000" Height="780" MinWidth="700" MinHeight="400">
    <!-- Обычное окно: может получать фокус. no-activate относится только к оверлею. Тексты задаются из ресурсов (Loc). -->
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="SettingsButton" Padding="12,5" Margin="0,0,8,6" Click="OnSettings" />
            <Button x:Name="HelpButton" Padding="12,5" Margin="0,0,8,6" Click="OnHelp" />
            <Button x:Name="ToggleOverlayButton" Padding="12,5" Margin="0,0,8,6" Click="OnToggleOverlay" />
            <Button x:Name="ExportButton" Padding="12,5" Margin="0,0,8,6" Click="OnExport" />
            <Button x:Name="FreezeButton" Padding="12,5" Margin="0,0,8,6" Click="OnFreeze" />
            <Button x:Name="ResetButton" Padding="12,5" Margin="0,0,8,6" Click="OnReset" />
            <Button x:Name="ToTrayButton" Padding="12,5" Margin="0,0,8,6" Click="OnToTray" />
            <Button x:Name="ExitButton" Padding="12,5" Margin="0,0,8,6" Click="OnExit" />
        </WrapPanel>
        <TextBlock x:Name="ModeText" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="ChecklistToggle" HorizontalAlignment="Left" Padding="12,5" Click="OnToggleChecklist" />
            <TextBlock x:Name="ChecklistText" TextWrapping="Wrap" Margin="4,8,4,0" />
        </StackPanel>
        <TextBox x:Name="StatsText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </DockPanel>
</Window>
