    "ru": "Фокус",
    "de": "Fokus",
    "fr": "Focus",
    "es": "Enfoque",
    "it": "Focus",
    "pt": "Foco",
    "nl": "Focus",
    "pl": "Skupienie",
    "cs": "Fokus",
    "hu": "Fókusz",
    "ro": "Focalizare",
    "sv": "Fokus",
    "da": "Fokus",
