<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Пример внешнего плагина Backpack: фокус (затемнение вокруг области). Собирается независимо от приложения:
      dotnet build lab/samples/Focus/Focus.csproj -c Release
    Пакет .bppkg: tools/pack-plugin.ps1 (см. docs/plugins/README.md).
    SDK не копируется в пакет (Private=false): во время работы его предоставляет Backpack.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Focus</AssemblyName>
    <RootNamespace>Focus</RootNamespace>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\Backpack.Sdk\Backpack.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
