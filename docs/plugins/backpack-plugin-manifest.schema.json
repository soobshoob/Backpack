{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backpack.invalid/schemas/backpack-plugin-manifest/v1.json",
  "title": "Backpack plugin manifest (format backpack-plugin, formatVersion 1)",
  "description": "manifest.json at the root of a .bppkg package. Structural rules only; Backpack additionally checks capabilities against the SDK, hotkey syntax, that commands/settings have their capability, and that entry/resources are safe paths inside the package. Schema version 1.1 (Backpack 0.4.0-preview.6): adds the optional top-level symbol and 19 text languages.",
  "type": "object",
  "required": ["format", "formatVersion", "id", "name", "author", "version", "sdk", "entry", "type", "license"],
  "properties": {
    "format": { "const": "backpack-plugin" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "maxLength": 96, "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){1,5}$" },
    "name": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "maxLength": 48, "pattern": "^\\d{1,5}\\.\\d{1,5}\\.\\d{1,5}(-[0-9A-Za-z.]{1,32})?$" },
    "sdk": { "type": "string", "maxLength": 16, "pattern": "^\\d+\\.\\d+$" },
    "entry": { "$ref": "#/$defs/packagePath", "pattern": "\\.[dD][lL][lL]$" },
    "type": { "type": "string", "minLength": 1, "maxLength": 200 },
    "license": { "type": "string", "minLength": 1, "maxLength": 200, "description": "The plugin's own license (SPDX identifier or a short statement pointing to LICENSE.txt in the package)." },
    "symbol": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+){0,4}$",
      "description": "Name of a Lucide icon from the catalog built into Backpack (PluginSymbols.Catalog). Not XAML, not a path, not a URL. Unknown names show the default icon; 'star' is reserved for favourites."
    },
    "icon": { "$ref": "#/$defs/packagePath", "pattern": "\\.[pP][nN][gG]$", "description": "Optional card picture (PNG up to 256 KB inside the package); shown only when there is no symbol." },
    "capabilities": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 32 } },
    "dependencies": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 96 } },
    "resources": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/packagePath" } },
    "locales": { "type": "array", "maxItems": 19, "items": { "$ref": "#/$defs/language" } },
    "commands": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "$ref": "#/$defs/localId" },
          "title": { "$ref": "#/$defs/text" },
          "hold": { "type": "boolean" },
          "whileTool": { "type": "boolean" },
          "hotkey": { "type": "string", "maxLength": 64 },
          "icon": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["key", "type", "title"],
        "properties": {
          "key": { "$ref": "#/$defs/localId" },
          "type": { "enum": ["toggle", "number", "text", "choice", "color"] },
          "title": { "$ref": "#/$defs/text" },
          "group": { "$ref": "#/$defs/text" },
          "hint": { "$ref": "#/$defs/text" },
          "default": {},
          "min": { "type": "number" },
          "max": { "type": "number" },
          "step": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "type": "string", "maxLength": 8 },
          "choices": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 64 } },
          "choiceTitles": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/text" } },
          "showWhen": { "type": "object", "minProperties": 1, "maxProperties": 1 },
          "hidden": { "type": "boolean" }
        }
      }
    },
    "preview": {
      "type": "object",
      "required": ["scene"],
      "properties": {
        "scene": { "enum": ["magnifier.follow", "magnifier.region", "dim", "panel", "drawing", "indicator"] },
        "bind": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": "string" } }
      }
    },
    "legacy": { "type": "object" }
  },
  "$defs": {
    "language": { "enum": ["en", "uk", "ru", "de", "fr", "es", "it", "pt", "nl", "pl", "cs", "hu", "ro", "sv", "da", "nb", "fi", "lt", "el"] },
    "text": {
      "description": "A string (English) or an object language → text. Put en, uk and ru first: Backpack before 0.4.0-preview.6 reads only the first eight keys and only these three languages.",
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 19,
          "propertyNames": { "$ref": "#/$defs/language" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      ]
    },
    "localId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9-]{0,31}$" },
    "packagePath": { "type": "string", "minLength": 1, "maxLength": 200, "not": { "pattern": "(^[/\\\\])|:|(^|[/\\\\])\\.\\.?([/\\\\]|$)" } }
  }
}
