{
  "$schema": "../backpack-theme.schema.json",
  "format": "backpack-theme",
  "formatVersion": 1,
  "id": "backpack.default",
  "name": "Backpack — по умолчанию",
  "description": "Встроенная тема по умолчанию: стиль lowprofile с теми же значениями параметров, что у Keyviz v2.1.1 по умолчанию. Все поля указаны явно, чтобы файл служил справочником значений.",
  "author": "Backpack",
  "version": "1.0.0",
  "license": "CC0-1.0",
  "keycap": { "style": "lowprofile", "size": 32 },
  "colors": { "primary": "#FFFFFF", "secondary": "#1A1A1A", "useGradient": true },
  "text": {
    "color": "#000000",
    "caps": "capitalize",
    "variant": "text-short",
    "alignment": "center",
    "font": { "families": ["Inter", "Segoe UI"], "weight": 400, "secondaryWeight": 600 }
  },
  "layout": { "showIcon": true, "showSymbol": true, "showPressCount": true, "iconAlignment": "end" },
  "modifier": { "highlight": false, "primary": "#3A86FF", "secondary": "#000000", "text": "#000000", "border": "#000000" },
  "border": { "enabled": true, "width": 2, "color": "#1A1A1A", "radius": 0.5 },
  "group": { "background": { "enabled": true, "color": "#FFFFFF99" } },
  "animation": { "type": "fade", "durationMs": 250 },
  "mouse": {
    "clickColor": "#009DFF",
    "clickSize": 150,
    "indicatorSize": 50,
    "indicatorBackground": "#00000080",
    "indicatorForeground": "#FFFFFF",
    "indicatorAccent": "#00FF6A"
  },
  "languageIndicator": { "textSize": 40, "showLayoutName": "ambiguous" }
}
