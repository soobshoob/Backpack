{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backpack curated plugin registry v1",
  "description": "JSON Schema is the structural layer. Also run the website semantic validator for unique ID/slug, SemVer/order, public HTTPS restrictions, raster image suffixes, direct .bppkg vs release URLs and checksum applicability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "author",
          "summary",
          "description",
          "version",
          "category",
          "tags",
          "distribution",
          "compatibility",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$"
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "not": {
              "enum": [
                "publish",
                "_route",
                "__registry_plugin__"
              ]
            }
          },
          "name": {
            "type": "object",
            "required": [
              "en"
            ],
            "minProperties": 1,
            "maxProperties": 40,
            "propertyNames": {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048,
                "pattern": "^https://"
              }
            }
          },
          "summary": {
            "type": "object",
            "required": [
              "en"
            ],
            "minProperties": 1,
            "maxProperties": 40,
            "propertyNames": {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "description": {
            "type": "object",
            "required": [
              "en"
            ],
            "minProperties": 1,
            "maxProperties": 40,
            "propertyNames": {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "category": {
            "enum": [
              "tools",
              "mouse",
              "keystrokes",
              "focus",
              "drawing",
              "styles",
              "productivity",
              "integrations"
            ]
          },
          "tags": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "distribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "url"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "package",
                  "release"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048,
                "pattern": "^https://"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minBackpack",
              "sdk",
              "platforms"
            ],
            "properties": {
              "minBackpack": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "maxBackpack": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "sdk": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$"
              },
              "platforms": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "enum": [
                    "windows-x64",
                    "windows-arm64"
                  ]
                }
              }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048,
                "pattern": "^https://"
              }
            }
          },
          "repositoryUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https://"
          },
          "icon": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https://"
          },
          "images": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "alt"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 2048,
                  "pattern": "^https://"
                },
                "alt": {
                  "type": "object",
                  "required": [
                    "en"
                  ],
                  "minProperties": 1,
                  "maxProperties": 40,
                  "propertyNames": {
                    "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "capabilities": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "changelog": {
            "type": "object",
            "required": [
              "en"
            ],
            "minProperties": 1,
            "maxProperties": 40,
            "propertyNames": {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          }
        }
      }
    }
  }
}
