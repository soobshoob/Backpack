{
  "name": "backpack-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "verify:static": "node scripts/check-static.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/v102-browser.mjs",
    "test:languages": "node tests/v102-languages.mjs",
    "test:production": "node tests/v102-production.mjs",
    "test:cycles": "node tests/v102-cycles.mjs",
    "qa:serve": "node tests/static-server.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "playwright": "1.62.1"
  },
  "packageManager": "pnpm@11.25.0"
}
